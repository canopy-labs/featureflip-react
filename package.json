{
  "name": "@featureflip/react",
  "version": "2.17.1",
  "description": "React SDK for Featureflip - React bindings for feature flag evaluation",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "feature-management",
    "featureflip",
    "react",
    "react-hooks",
    "typescript",
    "sdk"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/canopy-labs/featureflip-react.git"
  },
  "homepage": "https://featureflip.io/docs/sdks/react/",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@featureflip/browser": "^2.16.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@featureflip/browser": "^2.16.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "lodash": ">=4.17.25"
  }
}
